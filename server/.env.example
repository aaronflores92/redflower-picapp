# --- Server ---
  PORT=4000
  CORS_ORIGIN=http://localhost:5173

  # --- PostgreSQL (Neon in dev, RDS in prod — same var, swap value) ---
  DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

  # --- Firebase Admin (server-side verification — distinct from client VITE_FIREBASE_* vars) ---
  FIREBASE_PROJECT_ID=
  FIREBASE_CLIENT_EMAIL=
  FIREBASE_PRIVATE_KEY=

  # --- AWS S3 ---
  AWS_REGION=us-east-1
  AWS_ACCESS_KEY_ID=
  AWS_SECRET_ACCESS_KEY=
  S3_BUCKET_NAME=